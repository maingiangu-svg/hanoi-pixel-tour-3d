+      group.add(rock)
+    }
+
+    // Cây cỏ bờ hồ
+    const grassGeo = new THREE.ConeGeometry(0.15, 0.4, 4)
+    const grassMat = new THREE.MeshStandardMaterial({ color: 0x4A7A42, roughness: 0.85 })
